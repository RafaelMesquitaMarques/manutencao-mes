# ─── Banco de dados ────────────────────────────────────────────
DB_NAME=manutencao
DB_USER=mesadmin
DB_PASSWORD=troque-em-producao

# ─── Segurança ─────────────────────────────────────────────────
# Gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao

# ─── Ambiente ──────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Email (notificações) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASSWORD=sua-senha-app

# ─── Upload de arquivos ────────────────────────────────────────
MAX_UPLOAD_MB=20

# Twilio SMS (deixe vazio para modo simulacao)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anthropic API key for Maintenance Intelligence (empty = calculator-only mode)
ANTHROPIC_API_KEY=

# Public URL of the app (cloudflared tunnel / reverse proxy) - enables the ack link in escalation SMS
PUBLIC_BASE_URL=
