# ─── Database ──────────────────────────────────────────────────
DB_NAME=manutencao
DB_USER=mesadmin
DB_PASSWORD=change-in-production

# ─── Security ──────────────────────────────────────────────────
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=change-this-key-in-production

# ─── Environment ───────────────────────────────────────────────
ENVIRONMENT=development

# ─── Email (notifications) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password

# ─── File uploads ──────────────────────────────────────────────
MAX_UPLOAD_MB=20

# Twilio SMS (leave empty for simulation mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anthropic API key for Maintenance Intelligence (empty = calculator-only mode)
ANTHROPIC_API_KEY=

# Public URL of the app (cloudflared tunnel / reverse proxy) - enables the ack link in escalation SMS
PUBLIC_BASE_URL=

# Yokogawa Sushi Sensor LoRaWAN ingest - the network server's HTTP integration
# must send this in the X-Ingest-Token header; empty disables /api/sushi/uplink
SUSHI_INGEST_TOKEN=
SUSHI_BYTE_ORDER=big
